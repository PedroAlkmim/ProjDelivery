# Modelo de configuração da Delivery API.
# Copie este arquivo para ".env" e ajuste os valores para cada máquina.

# Conexão com o PostgreSQL:
DATABASE_URL=postgresql+psycopg2://SEU_USUARIO:SUA_SENHA@localhost:5432/NOME_DO_BANCO

# Chave secreta para assinatura dos tokens JWT.
# Gere uma chave longa e aleatória para cada ambiente.
SECRET_KEY=COLOQUE_UMA_CHAVE_LONGA_E_ALEATORIA_AQUI

# Validade do token em minutos
TOKEN_EXPIRE_MINUTES=120

# Taxa de entrega fixa aplicada aos pedidos (R$)
TAXA_ENTREGA=5.00
